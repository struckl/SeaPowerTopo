<Project Sdk="Microsoft.NET.Sdk">

  <!--The common part (framework, game references, deploy, the reference to R.A.T.S. Rigging) comes from Rigging's
      build\Rats.Mod.props: SeaPowerRigging\build\Rats.Mod.props in the workspace.
      -p:RatsWorkspace=<workspace> builds from a clone outside it, -p:RatsRigging=<folder>\ against another copy of the Rigging repo.-->
  <PropertyGroup>
    <AssemblyName>SeaPowerTopo</AssemblyName>
    <RootNamespace>SeaPowerTopo</RootNamespace>
    <Product>Terrain heights on Sea Power's tactical map.</Product>
    <Version>1.8.1</Version>
    <!--Terrain heights are read straight from the game's DEM buffers.-->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RatsWorkspace Condition="'$(RatsWorkspace)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), mods.json))</RatsWorkspace>
    <RatsRigging Condition="'$(RatsRigging)' == ''">$([MSBuild]::EnsureTrailingSlash('$(RatsWorkspace)'))SeaPowerRigging\</RatsRigging>
  </PropertyGroup>

  <Import Project="$(RatsRigging)build\Rats.Mod.props" />

  <ItemGroup>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CommunityToolkit.Mvvm"><HintPath>$(ManagedDir)\CommunityToolkit.Mvvm.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedDir)\Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(ManagedDir)\Unity.Collections.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
