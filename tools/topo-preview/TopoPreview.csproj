<Project Sdk="Microsoft.NET.Sdk">

  <!--Offline preview of the Topographic Map overlay: renders PNGs from the game's own terrain files with the
      plugin's Palette and Raster code, so colours, contours and shading can be tuned without starting the game.-->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SeaPowerTopo.Preview</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">E:\Games\steamapps\common\Sea Power</GameDir>
  </PropertyGroup>

  <!--The plugin's plain C# render code, compiled in as it is (no copies): every Render file but the three that use Unity.-->
  <ItemGroup>
    <Compile Include="..\..\src\SeaPowerTopo\Render\*.cs" Exclude="..\..\src\SeaPowerTopo\Render\OverlayRenderer.cs;..\..\src\SeaPowerTopo\Render\FlatMapRef.cs;..\..\src\SeaPowerTopo\Render\GlobeMesh.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

</Project>
