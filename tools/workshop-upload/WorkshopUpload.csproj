<Project Sdk="Microsoft.NET.Sdk">

  <!--Dev-only: updates the Workshop item through the Steam client, like the game's Mods > Create Mod. Never shipped.-->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">E:\Games\steamapps\common\Sea Power</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!--The game's own Steamworks.NET and steam_api64.dll, so the wrapper and the native API always match.-->
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
    </Reference>
    <None Include="$(GameDir)\Sea Power_Data\Plugins\x86_64\steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Link="steam_api64.dll" />
  </ItemGroup>

</Project>
